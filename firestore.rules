rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return isSignedIn() && (
        getEmail().toLowerCase() == "itdepartmentpro33@gmail.com" ||
        getEmail().toLowerCase() == "djbmremix87@gmail.com" ||
        getEmail().toLowerCase() == "itdepartmentpro33@app.internal" ||
        getEmail().toLowerCase() == "djbmremix87@app.internal"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- Collections ---

    // Individual User Data
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      // Allow decreasing stock during order placement for non-admins
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    // Offers
    match /offers/{offerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn();
    }

    // Alerts
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Staff
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow update: if isSignedIn() && (isAdmin() || getEmail().toLowerCase() == resource.data.get('email', '').toLowerCase());

      match /history/{historyId} {
        allow read: if isAdmin();
        allow create: if isSignedIn() && (isAdmin() || getEmail().toLowerCase() == get(/databases/$(database)/documents/staff/$(staffId)).data.get('email', '').toLowerCase());
      }
    }

    // Public Orders
    match /public_orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Settings
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Clients
    match /clients/{clientId} {
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.get('email', '') == getEmail());
      allow write: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    // Health check
    match /test/connection {
      allow read: if true;
    }
  }
}
