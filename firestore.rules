rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'itdepartmentpro33@gmail.com',
          'djbmremix87@gmail.com',
          'itdepartmentpro33@app.internal',
          'djbmremix87@app.internal'
        ] ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/staff_members/$(request.auth.uid)) ||
        request.auth.token.staff == true
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPublicOrder(data) {
      return data.keys().hasAll(['customerName', 'customerPhone', 'total', 'items'])
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 30
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['subject', 'category', 'description'])
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
        && data.description is string && data.description.size() > 0 && data.description.size() <= 5000;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Services collection: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Offers collection: Public read, Admin write
    match /offers/{offerId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Alerts collection: Public read active alerts, Admin write
    match /alerts/{alertId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Portfolio collection: Public read, Admin write
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Public Orders: Public can submit order; Admins & Staff manage orders
    match /public_orders/{orderId} {
      allow create: if isValidPublicOrder(incoming());
      allow read, list: if isAdmin() || isStaff() || (isSignedIn() && existing().customerUid == request.auth.uid);
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // Clients collection: Admin and Staff full access, Client can read own profile
    match /clients/{clientId} {
      allow read: if isAdmin() || isStaff() || isOwner(clientId) || (isSignedIn() && existing().email == request.auth.token.email);
      allow create, update, delete: if isAdmin() || isStaff();
    }

    // Expenses collection: Admin & Staff financial records
    match /expenses/{expenseId} {
      allow read, write, create, update, delete: if isAdmin() || isStaff();
    }

    // Staff collection & location history: Admin manage, Staff read/update own location
    match /staff/{staffId} {
      allow read: if isAdmin() || isStaff() || isOwner(staffId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwner(staffId);

      match /history/{historyId} {
        allow read: if isAdmin() || isOwner(staffId);
        allow create: if isAdmin() || isOwner(staffId);
        allow update, delete: if isAdmin();
      }
    }

    // Support Tickets collection
    match /tickets/{ticketId} {
      allow create: if isValidSupportTicket(incoming());
      allow read: if isAdmin() || isStaff() || (isSignedIn() && existing().clientUid == request.auth.uid);
      allow update: if isAdmin() || isStaff() || (isSignedIn() && existing().clientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Notifications collection: Restricted to owner or admin
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
    }

    // Audit Logs collection: Read by Admin; Create by authenticated users; Immutable
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Global Settings collection: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write, update: if isAdmin();
    }

    // Users collection: Strict ownership and admin management
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isStaff();
      allow create: if isOwner(userId) && (!("role" in incoming()) || incoming().role == "user" || isAdmin());
      allow update: if (isOwner(userId) && (!("role" in incoming()) || incoming().role == existing().role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins metadata collection
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write, create, update, delete: if isAdmin();
    }
  }
}
