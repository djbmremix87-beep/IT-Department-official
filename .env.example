# Netlify Production Environment Variables Template
# Copy these variables into Netlify Site settings > Build & deploy > Environment variables

# Gemini API Key for AI features (Server-side)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Integration (Server-side proxy)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Firebase Client Configuration (Optional if bundled via firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
