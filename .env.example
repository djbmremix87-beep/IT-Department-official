# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot Integration (Server-side ONLY - Do not expose to client VITE_ vars)
# ROTATION WARNING: If a Telegram Bot token was previously saved in client localStorage or .env,
# revoke it immediately in Telegram @BotFather using /revoke and set the new token here.
TELEGRAM_BOT_TOKEN="your_server_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_server_telegram_chat_id_here"
